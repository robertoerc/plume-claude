#!/bin/sh
# plume-mcp: starts plume's MCP server with the binary built for this Mac's chip.
# The binaries are plume's connector compiled with `bun build --compile`, so Node isn't needed.
dir=$(cd "$(dirname "$0")" && pwd)
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) exec "$dir/plume-mcp-darwin-arm64" "$@" ;;
  Darwin-x86_64) exec "$dir/plume-mcp-darwin-x64" "$@" ;;
  *) echo "plume: runs on macOS only (this is $(uname -s) $(uname -m))" >&2; exit 1 ;;
esac
